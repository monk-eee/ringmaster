# Local development only (ADR-0004). Copy to .env and adjust if needed;
# .env is gitignored.
POSTGRES_USER=ringmaster
POSTGRES_PASSWORD=ringmaster-dev
POSTGRES_DB=ringmaster

# Optional model adapter (ADR-0011). Extraction stays disabled unless both
# are set. Defaults in compose.yaml already point at a local Ollama server.
#RINGMASTER_LLM_URL=http://host.containers.internal:11434/v1
#RINGMASTER_MODEL=glm-4.7-flash:latest
# ADR-0065: set to use a hosted model (OpenAI-compatible) instead of Ollama --
# e.g. RINGMASTER_LLM_URL=https://api.openai.com/v1, RINGMASTER_MODEL=gpt-4o-mini.
# Leave unset for Ollama, which needs no key.
#RINGMASTER_LLM_API_KEY=

# Optional hosted embedding adapter (ADR-0018, ADR-0068). The configured
# model must return 768 dimensions to match the current pgvector schema.
#RINGMASTER_EMBEDDING_URL=https://provider.example/v1
#RINGMASTER_EMBEDDING_MODEL=provider-model-that-returns-768-dimensions
#RINGMASTER_EMBEDDING_API_KEY=
# Keyless local Ollama remains supported:
#RINGMASTER_EMBEDDING_URL=http://host.containers.internal:11434/v1
#RINGMASTER_EMBEDDING_MODEL=nomic-embed-text
