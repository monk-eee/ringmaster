# Local development only (ADR-0004). Copy to .env and adjust if needed;
# .env is gitignored.
POSTGRES_USER=ringmaster
POSTGRES_PASSWORD=ringmaster-dev
POSTGRES_DB=ringmaster

# Optional model adapter (ADR-0011). Extraction stays disabled unless both
# are set. Defaults in compose.yaml already point at a local Ollama server.
#RINGMASTER_LLM_URL=http://host.containers.internal:11434/v1
#RINGMASTER_MODEL=glm-4.7-flash:latest

# Optional embedding adapter (ADR-0018). Same posture as above.
#RINGMASTER_EMBEDDING_URL=http://host.containers.internal:11434/v1
#RINGMASTER_EMBEDDING_MODEL=nomic-embed-text
